# ==========================================
# SpeciesTrace System Environment Template
# Rename this file to `.env` for local/production deployments
# ==========================================

# --- System Environment ---
ENVIRONMENT=production

# --- Security Configuration ---
# IMPORTANT: Change this key to a strong 64-character random string in production!
SECRET_KEY=dev-secret-key-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database Configuration ---
# SQLite default (persistent volume):
DATABASE_URL=sqlite:////app/data/speciestrace.db

# PostgreSQL alternative format (uncomment for PostgreSQL production setups):
# DATABASE_URL=postgresql://speciestrace_user:secure_password_123@postgres_db:5432/speciestrace_db

# --- Port Binding Configuration ---
BACKEND_PORT=8000
PORTAL_PORT=3000

# --- CORS & Domain Setup ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
